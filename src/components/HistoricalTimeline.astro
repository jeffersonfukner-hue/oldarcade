---
import {historicalTimelines,type HistoricalGame} from '../data/historicalTimeline';
interface Props { game:HistoricalGame }
const {game}=Astro.props;
const milestones=historicalTimelines[game];
const trail=['4,5','5,5','6,5','6,4','6,3','7,3'];
const green=['2,5','3,5','4,5','4,4','5,4','5,3'];
const tetrominoes=[{x:28,y:30,fill:'#6ce3df',cells:[[0,0],[1,0],[1,1],[2,1]]},{x:106,y:18,fill:'#b496ff',cells:[[0,0],[0,1],[0,2],[1,2]]},{x:170,y:48,fill:'#ffb755',cells:[[0,0],[1,0],[2,0],[1,1]]}];
const pixelSize=16;
---
<ol class="timeline oa-illustrated-timeline" aria-label={`Linha do tempo ilustrada de ${game}`}>
 {milestones.map((item,i)=>
  <li>
   <div class="oa-era-entry">
    <figure class="oa-era-visual">
     <svg class="oa-era-art" viewBox="0 0 280 142" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={`Ilustração editorial original: ${item.title}`} preserveAspectRatio="xMidYMid slice">
      <defs>
       <linearGradient id={`era-bg-${game}-${i}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color={game==='pixel-quest'?'#1e4758':game==='tetris'?'#162b57':'#143d3b'} /><stop offset="100%" stop-color="#0a1022"/></linearGradient>
       <pattern id={`era-grid-${game}-${i}`} width="18" height="18" patternUnits="userSpaceOnUse"><path d="M18 0H0V18" stroke="#ffffff" stroke-opacity=".045" fill="none"/></pattern>
      </defs>
      <rect width="280" height="142" fill={`url(#era-bg-${game}-${i})`}/>
      <rect width="280" height="142" fill={`url(#era-grid-${game}-${i})`}/>
      {game==='snake'&&<>
       {Array.from({length:7},(_,j)=><rect x={22+j*34} y="22" width="28" height="28" rx="3" fill="#203d50" stroke="#3c6e7a"/>)}
       {(item.scene==='trail'?trail:green).map(pos=>{const [x,y]=pos.split(',').map(Number);return <rect x={x*20+30} y={y*16-22} width="18" height="14" rx="2" fill={item.scene==='trail'?'#f0a0fa':'#69f3a0'} stroke="#13282b" stroke-width="2"/>})}
       <rect x="80" y="76" width="17" height="17" rx="2" fill="#f67a91"/>
       <circle cx="87" cy="80" r="2" fill="#fff"/>
       {item.scene==='phone'&&<><rect x="111" y="10" width="64" height="122" rx="9" fill="#b4c6ce" stroke="#586d83" stroke-width="5"/><rect x="119" y="24" width="48" height="63" rx="2" fill="#9fbe99"/>{Array.from({length:12},(_,j)=><rect x={123+(j%3)*14} y={95+Math.floor(j/3)*8} width="9" height="5" rx="2" fill="#546579"/>)}</>}
      </>}
      {game==='tetris'&&<>
       {tetrominoes.map(piece=>piece.cells.map(([x,y])=><rect x={piece.x+x*pixelSize} y={piece.y+y*pixelSize} width="15" height="15" fill={piece.fill} stroke="#101a32" stroke-width="2"/ >))}
       {Array.from({length:8},(_,j)=><rect x={48+j*24} y="112" width="22" height="22" fill={j%2?'#6c6bf9':'#56c9e1'} stroke="#141d36" stroke-width="2"/>)}
       {item.scene==='computer'&&<><rect x="88" y="12" width="112" height="86" rx="7" fill="#ccd4e3" stroke="#74849c" stroke-width="5"/><rect x="100" y="23" width="88" height="60" fill="#0b2939"/><text x="111" y="56" fill="#9ff4a8" font-size="12" font-family="monospace">[][][]</text></>}
       {item.scene==='handheld'&&<><rect x="102" y="8" width="82" height="126" rx="13" fill="#d9cce5" stroke="#827b9a" stroke-width="4"/><rect x="112" y="23" width="61" height="62" rx="3" fill="#7c9e8d"/><circle cx="135" cy="111" r="9" fill="#68537f"/><circle cx="157" cy="102" r="7" fill="#68537f"/></>}
      </>}
      {game==='pixel-quest'&&<>
       <circle cx="232" cy="24" r="18" fill="#7298da" opacity=".35"/>
       {Array.from({length:9},(_,j)=><rect x={j*36} y={96+(j%3)*8} width="34" height="12" fill={item.scene==='forest'?'#72df8c':'#ec7fb1'} stroke="#273a4a" stroke-width="3"/>)}
       {[30,124,211].map((x,j)=><g><rect x={x} y={j===1?43:55} width="7" height={j===1?54:43} fill="#efbe71"/>{Array.from({length:4},(_,k)=><rect x={x} y={(j===1?51:63)+k*10} width="7" height="3" fill="#fff1bf"/>)}</g>)}
       {item.scene==='barrels'&&[52,90,174].map((x,j)=><g><rect x={x} y={66+j*7} width="20" height="18" rx="5" fill="#db965b" stroke="#613b49" stroke-width="3"/><path d={`M${x+6} ${66+j*7}v18`} stroke="#71445a" stroke-width="3"/></g>)}
       {item.scene==='scroll'&&<><rect x="18" y="111" width="245" height="20" fill="#59c98f"/>{[45,153,214].map(x=><rect x={x} y="68" width="25" height="25" fill="#e2a768" stroke="#3d4c69" stroke-width="3"/>)}<rect x="190" y="67" width="28" height="48" fill="#419b7c"/></>}
       {item.scene==='forest'&&<><path d="M0 48L40 4L74 52L112 12L155 61" fill="none" stroke="#337a65" stroke-width="14"/>{[95,165,195].map((x,j)=><polygon points={`${x},${28+j*5} ${x+9},${40+j*5} ${x},${52+j*5} ${x-9},${40+j*5}`} fill="#75f6d3" stroke="#24877b" stroke-width="2"/>)}<rect x="218" y="45" width="35" height="54" rx="18" fill="#2ed7bd" stroke="#b6ffe7" stroke-width="6"/></>}
       <rect x="82" y="75" width="14" height="20" rx="2" fill={item.scene==='forest'?'#a8f16b':'#8cbeff'}/><rect x="86" y="65" width="11" height="12" fill="#ffe2b6"/><rect x="78" y="65" width="23" height="5" fill="#ed9772"/>
      </>}
     </svg>
     <figcaption>Ilustração editorial original · não é captura do jogo</figcaption>
    </figure>
    <div class="oa-era-copy">
     <strong class="oa-era-date">{item.date} · {item.title}</strong>
     <p>{item.description}</p>
     <span class="oa-era-source">Fonte histórica: <a href={item.sourceUrl} target={item.sourceUrl.startsWith('http')?'_blank':undefined} rel={item.sourceUrl.startsWith('http')?'noopener noreferrer':undefined}>{item.sourceLabel}</a></span>
    </div>
   </div>
  </li>
 )}
</ol>
<style>
 .oa-illustrated-timeline{display:grid;gap:14px;list-style:none;padding-left:16px;margin-block:20px 30px}
 .oa-illustrated-timeline>li{margin:0;padding:0;min-width:0}
 .oa-era-entry{display:grid;grid-template-columns:minmax(0,220px) minmax(0,1fr);gap:16px;align-items:center;padding:12px;border:1px solid #344362;border-radius:14px;background:linear-gradient(135deg,#17243d,#10182b)}
 .oa-era-visual{margin:0;min-width:0}
 .oa-era-art{display:block;width:100%;height:auto;aspect-ratio:280/142;border-radius:9px;overflow:hidden;border:1px solid #4f577b}
 .oa-era-visual figcaption{font-size:.69rem;line-height:1.35;color:#95a6c5;margin-top:5px}
 .oa-era-date{display:block;color:#e4ddff;font-weight:850;font-size:1.04rem;margin-bottom:5px}
 .oa-era-copy{min-width:0}
 .oa-era-copy p{margin:0 0 8px;font-size:.92rem;line-height:1.5}
 .oa-era-source{font-size:.75rem;color:#9aa9c7;line-height:1.45;overflow-wrap:anywhere}
 .oa-era-source a{text-decoration:underline;text-underline-offset:2px;color:#c8baff}
 @media(max-width:520px){.oa-era-entry{grid-template-columns:1fr;gap:10px}.oa-era-art{max-height:165px}.oa-illustrated-timeline{padding-left:12px}.oa-era-copy p{font-size:.9rem}}
</style>
