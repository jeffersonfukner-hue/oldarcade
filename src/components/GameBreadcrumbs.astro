---
/** Componente global. A trilha corresponde exatamente ao BreadcrumbList condicional do Base. */
import type {BreadcrumbItem} from '../data/breadcrumbs';
interface Props {items:BreadcrumbItem[]}
const {items}=Astro.props;
---
{items.length>0&&<nav class="oa-breadcrumbs shell" aria-label="Caminho de navegação" data-breadcrumbs>
 <ol>
  {items.map((item,index)=><li>
   {index===items.length-1
    ?<span aria-current="page">{item.label}</span>
    :<a href={item.href}>{item.label}</a>}
  </li>)}
 </ol>
</nav>}
