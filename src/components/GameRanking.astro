---
import {isTimeRanking,isLowerBetter} from '../data/rankingRules.js';
interface Props {game:string;name:string;slot?:string}
const {game,name}=Astro.props;
const timed=isTimeRanking(game);
const lowerBetter=isLowerBetter(game);
---
<section class="section panel mode-ranking" id={"ranking-"+game} data-mode-ranking data-game={game} data-ranking-metric={timed?"time":"points"} aria-label={`Ranking global do ${name}`}>
 <div class="section-head"><div><span class="eyebrow">Desafio Old Arcade</span><h2>Ranking global — {name}</h2></div><span class="pill">Contas cadastradas</span></div>
 <p class="small muted">{timed?(lowerBetter?'Vence quem completa 40 linhas no menor tempo.':'Vence quem sobrevive pelo maior tempo.'):'Vence a maior pontuação.'} Empates seguem os critérios do modo. Qualquer pessoa pode consultar a classificação; somente contas registram resultados.</p>
 <h3 class="oa-ranking-podium-title">Pódio — Top 3</h3>
 <div class="rankings-podium" data-rank-podium><p class="small muted">Consultando classificação…</p></div>
 <details class="rankings-top10"><summary>Ver classificação completa (Top 10)</summary>
  <div class="ranking-overflow"><table class="ranking"><thead><tr><th>Posição</th><th>Nickname</th><th>{timed?"Tempo":"Pontos"}</th><th>Registrado em</th></tr></thead><tbody data-rank-body><tr><td colspan="4">Carregando…</td></tr></tbody></table></div>
 </details>
 <p data-rank-mine class="small" hidden></p>
 <p data-rank-status class="small muted" role="status">Consultando classificação…</p>
 <p data-rank-summary class="record-end-summary" role="status" aria-live="polite"></p>
 <div class="oa-ranking-cache" hidden aria-hidden="true"><span data-rank-global>—</span><span data-rank-personal>—</span><span data-rank-provisional hidden></span></div>
</section>
<script>import '../scripts/modeRanking.ts';</script>
