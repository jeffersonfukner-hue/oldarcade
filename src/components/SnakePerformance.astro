---
import GameActivityStrip from './GameActivityStrip.astro';
---
<aside class="oa-compact-activity" aria-label="Atividade do jogo">
 <GameActivityStrip playsId="plays" prefix="global" />
 <div hidden aria-hidden="true"><strong id="score">0</strong><span id="snake-best-label">Recorde local</span><strong id="best">0</strong><strong id="visits">0</strong><p id="challenge-text"></p><span id="global-best-label">Recorde global (contas)</span><strong id="global-best">—</strong><form id="nickname-form"><input id="nickname" maxlength="18" autocomplete="nickname"/><button type="submit">Salvar</button></form><p id="nick-status"></p></div>
</aside>
