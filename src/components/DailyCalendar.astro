---
/** Calendário compartilhado por título. A API determina data, participação e sessão. */
import {dailyMode} from '../data/dailyChallenges.js';
interface Props{game:string}
const {game}=Astro.props;
const mode=dailyMode(game);
if(!mode)throw new Error('Desafio Diário não habilitado para '+game);
---
<section class="section panel daily-calendar" data-daily-calendar={game} aria-labelledby={`daily-title-${game}`}>
 <span class="eyebrow">Benefício extra de quem participa</span>
 <h2 id={`daily-title-${game}`}>📅 {mode.label}</h2>
 <p class="small muted">{mode.rules}</p>
 <div class="daily-calendar-bar">
  <button type="button" data-daily-previous aria-label="Mês anterior">‹</button>
  <strong data-daily-month aria-live="polite">Consultando calendário…</strong>
  <button type="button" data-daily-next aria-label="Próximo mês">›</button>
 </div>
 <div class="daily-calendar-weekdays" aria-hidden="true">{['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'].map(day=><span>{day}</span>)}</div>
 <div data-daily-days class="daily-calendar-grid" role="group" aria-label="Dias do desafio diário"></div>
 <p class="small muted" data-daily-info role="status" aria-live="polite">Verificando sua conta e seus desafios…</p>
 <p class="small muted">O dia começa e termina à meia-noite, no horário de Brasília. Datas passadas não podem ser jogadas novamente.</p>
 <div data-daily-guest-explanation class="contact-note" hidden role="status"><strong>Este desafio é exclusivo para quem tem conta.</strong><p class="small">Você pode jogar livremente sem cadastro. A conta gratuita permite guardar seu histórico, disputar rankings e participar do desafio de cada dia. O login existe para identificar sua tentativa e impedir repetições, não para cobrar pelo jogo.</p></div><a class="btn secondary" data-daily-login href="/conta/" hidden>🔐 Entrar ou criar conta grátis</a>
 <button class="btn" type="button" data-daily-start hidden disabled>▶ Iniciar desafio de hoje</button>
 <p class="small muted" data-daily-result hidden>Você já utilizou sua tentativa. Consulte seu desempenho em <a href="/conta/#daily-history">Minha conta</a>.</p>
</section>
<style>
 .daily-calendar{max-width:900px}
 .daily-calendar-bar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:1rem 0 .75rem}
 .daily-calendar-bar button{width:40px;min-height:40px;border:1px solid #6374a4;border-radius:9px;background:#1f2948;color:#fff;font-size:1.5rem}
 .daily-calendar-weekdays,.daily-calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px;text-align:center}
 .daily-calendar-weekdays span{font-size:.78rem;color:#aab9d9;font-weight:700;padding:.4rem 0}
 .daily-day{border:1px solid #344561;background:#121b32;min-height:46px;border-radius:9px;color:#c6d4ef;padding:5px 1px;font-variant-numeric:tabular-nums}
 .daily-day[data-status="today"]{border-color:#af99ff;color:#fff;box-shadow:inset 0 0 0 1px #6556aa}
 .daily-day[data-status="finished"]{background:#1c4036;color:#c2ffe2}
 .daily-day[data-status="started"]{background:#493c24;color:#ffe5ab}
 .daily-day[disabled]{cursor:default}
 .daily-day .daily-mark{display:block;font-size:.7rem;line-height:1.1}
 .daily-day-spacer{min-height:44px}
 .daily-calendar [hidden]{display:none!important}
 @media(max-width:420px){.daily-calendar-grid{gap:3px}.daily-day{min-height:42px;font-size:.8rem}}
</style>
<script>import '../scripts/dailyCalendar.ts';</script>
