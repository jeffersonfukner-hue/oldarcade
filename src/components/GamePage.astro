---
import Base from '../layouts/Base.astro';
import {gameMode} from '../data/gameModes.js';
import {gameRegistry} from '../data/gameRegistry';
interface Props { modeId:string; title:string; description:string; structured?:Record<string,unknown> }
const {modeId,title,description,structured}=Astro.props;
const mode=gameMode(modeId);
if(!mode)throw new Error('Modalidade não cadastrada: '+modeId);
if(!Object.hasOwn(gameRegistry,mode.title))throw new Error('Jogo sem registro editorial: '+mode.title);
const schema=structured??{'@context':'https://schema.org','@type':'VideoGame',name:mode.name,description,inLanguage:'pt-BR',gamePlatform:'Web browser',applicationCategory:'Game',isAccessibleForFree:true,operatingSystem:'Any',author:{'@type':'Organization',name:'OldArcade'}};
---
<Base title={title} description={description} path={mode.url}>
 <script type="application/ld+json" set:html={JSON.stringify(schema)} />
 <slot />
 <div id="game-celebration" class="oa-celebration" hidden aria-live="polite" aria-atomic="true"><div class="oa-celebration-card"><span data-celebration-icon></span><strong data-celebration-title></strong><p data-celebration-message></p><a data-celebration-replay class="btn" href={mode.url} hidden>▶ Jogar novamente</a></div></div>
 <aside id="celebration-test-panel" class="oa-test-panel" hidden aria-label="Simulador de comemorações"><details><summary>🧪 Testar comemorações · Preview</summary><p>Simulação visual. Não altera pontuações nem rankings.</p><div class="oa-test-actions">{[["personal","✨ Recorde pessoal"],["mission","🎯 Missão cumprida"],["podium","🥉 Top 3"],["leader","🏆 Liderança"],["rival","⚡ Fui ultrapassado"]].map(([kind,label])=><button type="button" data-test-celebration={kind}>{label}</button>)}</div></details></aside>
 <script>import '../scripts/gameCelebration.ts';</script>
 <style is:global>
 .oa-test-panel[hidden]{display:none!important}.oa-test-panel{position:fixed;right:12px;bottom:12px;z-index:90;width:min(320px,calc(100vw - 24px));background:#171c34;color:#fff;border:1px solid #8295bf;border-radius:12px;padding:10px;box-shadow:0 10px 30px #0008;font-size:.85rem}.oa-test-panel summary{cursor:pointer;font-weight:700}.oa-test-panel p{margin:.6rem 0}.oa-test-actions{display:grid;grid-template-columns:1fr 1fr;gap:6px}.oa-test-actions button{cursor:pointer;background:#313f65;color:white;border:1px solid #6479a6;border-radius:8px;padding:8px;font-size:.8rem}.oa-test-actions button:focus-visible{outline:3px solid #ffe36e}.oa-celebration[hidden]{display:none!important}.oa-celebration{position:fixed;z-index:80;inset:0;display:grid;place-items:start center;pointer-events:none;padding:clamp(4rem,12vh,7rem) 1rem 1rem}.oa-celebration-card{position:relative;max-width:min(86vw,360px);width:max-content;min-width:min(70vw,240px);padding:.7rem 1.2rem;text-align:center;border:1px solid #ffdd6099;border-radius:1rem;background:linear-gradient(145deg,#352060a6,#121a38a6);color:white;box-shadow:0 0 22px #ffda5866;backdrop-filter:blur(2px);animation:oa-pop .5s cubic-bezier(.2,1.8,.4,1)}.oa-celebration-card:before,.oa-celebration-card:after{content:"✦ ✧ ✦";position:absolute;top:-1.5rem;left:5%;color:#ffdd60;font-size:2rem;animation:oa-spark 1s infinite alternate}.oa-celebration-card:after{left:auto;right:5%;color:#62e9ff;animation-delay:.3s}.oa-celebration-card strong{display:block;font-size:clamp(1.1rem,3vw,1.7rem);line-height:1.1;color:#ffe36e;text-shadow:2px 3px #a5388a}.oa-celebration-card span{display:block;font-size:1.8rem}.oa-celebration-card p{font-size:.85rem;margin:.35rem 0}.oa-celebration.is-rival{pointer-events:auto;place-items:center;padding:1rem}.oa-celebration.is-rival .oa-celebration-card{max-width:min(92vw,520px);width:100%;padding:1.6rem;background:linear-gradient(145deg,#352060,#121a38)}.oa-celebration.is-rival .oa-celebration-card{border-color:#ff648b;box-shadow:0 0 0 999vmax #09091baa,0 0 55px #ff648b88}.oa-celebration.is-rival .oa-celebration-card strong{color:#ff9aaf}.oa-celebration.is-rival [data-celebration-replay]{display:inline-flex}@keyframes oa-pop{from{opacity:0;transform:scale(.55) rotate(-5deg)}to{opacity:1;transform:scale(1) rotate(0)}}@keyframes oa-spark{to{transform:translateY(-12px) rotate(18deg)}}@media(prefers-reduced-motion:reduce){.oa-celebration-card,.oa-celebration-card:before,.oa-celebration-card:after{animation:none}}
 </style>
</Base>
