---
import Base from '../layouts/Base.astro';
import {gameMode} from '../data/gameModes.js';
import {gameRegistry} from '../data/gameRegistry';
interface Props { modeId:string; title:string; description:string; structured?:Record<string,unknown> }
const {modeId,title,description,structured}=Astro.props;
const mode=gameMode(modeId);
if(!mode)throw new Error('Modalidade não cadastrada: '+modeId);
if(!Object.hasOwn(gameRegistry,mode.title))throw new Error('Jogo sem registro editorial: '+mode.title);
const schema=structured??{'@context':'https://schema.org','@type':'VideoGame',name:mode.name,description,inLanguage:'pt-BR',gamePlatform:'Web browser',applicationCategory:'Game',isAccessibleForFree:true,operatingSystem:'Any',author:{'@type':'Organization',name:'OldArcade'}};
---
<Base title={title} description={description} path={mode.url}>
 <script type="application/ld+json" set:html={JSON.stringify(schema)} />
 <slot />
 <div id="game-celebration" class="oa-celebration" hidden aria-live="polite" aria-atomic="true"><div class="oa-celebration-card"><span data-celebration-icon></span><strong data-celebration-title></strong><p data-celebration-message></p><a data-celebration-replay class="btn" href={mode.url} hidden>▶ Jogar novamente</a></div></div>
 <script>import '../scripts/gameCelebration.ts';</script>
 <style is:global>
 .oa-celebration[hidden]{display:none!important}.oa-celebration{position:fixed;z-index:80;inset:0;display:grid;place-items:center;pointer-events:none;padding:1rem}.oa-celebration-card{position:relative;max-width:min(92vw,520px);width:100%;padding:1.6rem;text-align:center;border:3px solid #ffdd60;border-radius:1.4rem;background:linear-gradient(145deg,#352060,#121a38);color:white;box-shadow:0 0 0 999vmax #09091b88,0 0 45px #ffda58aa;animation:oa-pop .5s cubic-bezier(.2,1.8,.4,1)}.oa-celebration-card:before,.oa-celebration-card:after{content:"✦ ✧ ✦";position:absolute;top:-1.5rem;left:5%;color:#ffdd60;font-size:2rem;animation:oa-spark 1s infinite alternate}.oa-celebration-card:after{left:auto;right:5%;color:#62e9ff;animation-delay:.3s}.oa-celebration-card strong{display:block;font-size:clamp(1.5rem,5vw,3rem);line-height:1.1;color:#ffe36e;text-shadow:2px 3px #a5388a}.oa-celebration-card span{display:block;font-size:3rem}.oa-celebration-card p{font-size:1.05rem;margin:.8rem 0}.oa-celebration.is-rival{pointer-events:auto}.oa-celebration.is-rival .oa-celebration-card{border-color:#ff648b;box-shadow:0 0 0 999vmax #09091baa,0 0 55px #ff648b88}.oa-celebration.is-rival .oa-celebration-card strong{color:#ff9aaf}.oa-celebration.is-rival [data-celebration-replay]{display:inline-flex}@keyframes oa-pop{from{opacity:0;transform:scale(.55) rotate(-5deg)}to{opacity:1;transform:scale(1) rotate(0)}}@keyframes oa-spark{to{transform:translateY(-12px) rotate(18deg)}}@media(prefers-reduced-motion:reduce){.oa-celebration-card,.oa-celebration-card:before,.oa-celebration-card:after{animation:none}}
 </style>
</Base>
