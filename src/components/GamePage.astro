---
import Base from '../layouts/Base.astro';
import {gameMode} from '../data/gameModes.js';
import {gameRegistry} from '../data/gameRegistry';
interface Props { modeId:string; title:string; description:string; structured?:Record<string,unknown> }
const {modeId,title,description,structured}=Astro.props;
const mode=gameMode(modeId);
if(!mode)throw new Error('Modalidade não cadastrada: '+modeId);
if(!Object.hasOwn(gameRegistry,mode.title))throw new Error('Jogo sem registro editorial: '+mode.title);
const schema=structured??{'@context':'https://schema.org','@type':'VideoGame',name:mode.name,description,inLanguage:'pt-BR',gamePlatform:'Web browser',applicationCategory:'Game',isAccessibleForFree:true,operatingSystem:'Any',author:{'@type':'Organization',name:'OldArcade'}};
---
<Base title={title} description={description} path={mode.url}>
 <script type="application/ld+json" set:html={JSON.stringify(schema)} />
 <slot />
 <div id="game-celebration" class="oa-celebration" hidden aria-live="polite" aria-atomic="true"><div class="oa-celebration-card"><span data-celebration-icon></span><strong data-celebration-title></strong><p data-celebration-message></p><a data-celebration-replay class="btn" href={mode.url} hidden>▶ Jogar novamente</a></div></div>
 <aside id="celebration-test-panel" class="oa-test-panel" hidden aria-label="Simulador de comemorações"><details><summary>🧪 Testar comemorações · Preview</summary><p>Simulação visual. Não altera pontuações nem rankings.</p><div class="oa-test-actions">{[["personal","✨ Recorde pessoal"],["mission","🎯 Missão cumprida"],["podium","🥉 Top 3"],["leader","🏆 Liderança"],["rival","⚡ Fui ultrapassado"],["danger","🐍 Perigo!"],["rescue","🍇 Salva-Cobra"],["provisional","🏆 Marca global"],["defeat","💥 Fim de jogo"]].map(([kind,label])=><button type="button" data-test-celebration={kind}>{label}</button>)}</div></details></aside>
 <script>import '../scripts/gameCelebration.ts';</script>
 <style is:global>
 .oa-test-panel[hidden]{display:none!important}.oa-test-panel{position:fixed;right:12px;bottom:12px;z-index:90;width:min(320px,calc(100vw - 24px));background:#171c34;color:#fff;border:1px solid #8295bf;border-radius:12px;padding:10px;box-shadow:0 10px 30px #0008;font-size:.85rem}.oa-test-panel summary{cursor:pointer;font-weight:700}.oa-test-panel p{margin:.6rem 0}.oa-test-actions{display:grid;grid-template-columns:1fr 1fr;gap:6px}.oa-test-actions button{cursor:pointer;background:#313f65;color:white;border:1px solid #6479a6;border-radius:8px;padding:8px;font-size:.8rem}.oa-test-actions button:focus-visible{outline:3px solid #ffe36e}.oa-celebration[hidden]{display:none!important}
 .oa-celebration{position:absolute;inset:0;z-index:80;display:grid;place-items:center;pointer-events:none;overflow:hidden}
 .oa-celebration-card{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.1rem;max-width:90%;padding:.3rem .6rem;text-align:center;border:0;background:transparent;color:#fff;box-shadow:none;animation:oa-record-burst 1.35s ease-out both;pointer-events:none}
 .oa-celebration-card:before,.oa-celebration-card:after{content:"✦ ✧ ✦";position:absolute;top:-1.2rem;left:-1rem;color:#ffdf65;font-size:1.6rem;animation:oa-spark 1s ease-out both}
 .oa-celebration-card:after{left:auto;right:-1rem;color:#6ff5ff;animation-delay:.12s}
 .oa-celebration-card strong{display:block;font-size:clamp(1.2rem,5vw,2.3rem);line-height:1.1;color:#ffe36e;text-shadow:0 0 10px #ffbb55,2px 3px #8b317d}
 .oa-celebration-card span{display:block;font-size:1.5rem}
 .oa-celebration-card p{font-size:.78rem;line-height:1.2;margin:.2rem 0;color:#fff}
 .oa-celebration:not(.is-rival) [data-celebration-replay]{display:none!important}
 .oa-celebration.is-final{position:fixed;inset:0;z-index:100;pointer-events:none;padding:1rem;background:#09091b66;overflow:hidden}
 .oa-celebration.is-final .oa-celebration-card{max-width:min(90vw,540px);padding:1.5rem;border-radius:1.4rem;background:#182040dd;box-shadow:0 0 45px #ffda5866;animation:oa-final-show 4s ease-in-out both}
 .oa-celebration.is-final .oa-celebration-card p{font-size:clamp(.9rem,2.5vw,1.1rem);line-height:1.5}
 @keyframes oa-final-show{0%{opacity:0;transform:scale(.65)}15%{opacity:1;transform:scale(1.08)}80%{opacity:1;transform:scale(1)}100%{opacity:0;transform:scale(1.08)}}
 .oa-celebration.is-rival{position:fixed;inset:0;z-index:100;pointer-events:auto;padding:1rem;background:#09091baa;overflow:auto}
 .oa-celebration.is-rival .oa-celebration-card{max-width:min(92vw,520px);width:100%;padding:1.6rem;border:3px solid #ff648b;border-radius:1.4rem;background:linear-gradient(145deg,#352060,#121a38);box-shadow:0 0 55px #ff648b88;pointer-events:auto;animation:oa-rival-pop .5s cubic-bezier(.2,1.8,.4,1) both}
 .oa-celebration.is-rival .oa-celebration-card strong{color:#ff9aaf}
 .oa-celebration.is-rival [data-celebration-replay]{display:inline-flex}
 @keyframes oa-record-burst{0%{opacity:0;transform:scale(.35)}32%{opacity:.5;transform:scale(1.1)}55%{opacity:.5;transform:scale(1.18)}100%{opacity:0;transform:scale(1.42)}}
 @keyframes oa-rival-pop{from{opacity:0;transform:scale(.55)}to{opacity:1;transform:scale(1)}}
 @keyframes oa-spark{0%{opacity:0;transform:translateY(8px) scale(.5)}40%{opacity:.7}100%{opacity:0;transform:translateY(-22px) rotate(25deg) scale(1.2)}}
 @media(prefers-reduced-motion:reduce){.oa-celebration-card,.oa-celebration-card:before,.oa-celebration-card:after{animation:none}.oa-celebration.is-final .oa-celebration-card{animation:none;opacity:1}.oa-celebration:not(.is-rival) .oa-celebration-card{opacity:.5}}
 </style>
</Base>