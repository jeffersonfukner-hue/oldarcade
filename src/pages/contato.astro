---
import Base from '../layouts/Base.astro';
import { support } from '../config/support';
---
<Base title="Contato e suporte — OldArcade" description="Envie dúvidas, sugestões e solicitações sobre contas e privacidade ao suporte do OldArcade pelo WhatsApp." path="/contato/">
 <div class="shell">
  <section class="hero text-content">
   <span class="eyebrow">Suporte</span><h1>Como podemos ajudar?</h1>
   <p class="lede">Escolha o assunto e preencha a mensagem. O WhatsApp será aberto para você confirmar o envio.</p>
  </section>
  <section class="section panel contact-panel">
   <h2>Entre em contato</h2>
   <form id="contact-form" data-whatsapp={support.whatsapp}>
    <label for="contact-subject">Motivo do contato</label>
    <select id="contact-subject" required>
     <option value="">Selecione uma opção</option>
     {support.subjects.map(s=><option value={s.key}>{s.label}</option>)}
    </select>
    <div id="recovery-info" class="contact-note" hidden>
     <strong>Dificuldade de acesso à conta</strong>
     <p>Informe seu nickname e descreva o problema sem enviar sua senha nem código de recuperação. O suporte poderá analisar a solicitação, mas não há redefinição automática de senha nem envio de links ou códigos por e-mail nesta versão.</p>
     <p class="small muted">O cadastro já está disponível; o suporte não deve solicitar sua senha. O código de recuperação exibido no cadastro ainda não possui fluxo público de redefinição.</p>
    </div>
    <label for="contact-nickname">Nickname <span class="muted">(opcional)</span></label>
    <input id="contact-nickname" maxlength="18" autocomplete="nickname" placeholder="Seu nickname, se lembrar"/>
    <label for="contact-email">E-mail <span id="email-description" class="muted">(opcional)</span></label>
    <input id="contact-email" type="email" maxlength="254" autocomplete="email" placeholder="voce@exemplo.com"/>
    <label for="contact-message">Mensagem <span class="muted">(opcional)</span></label>
    <textarea id="contact-message" rows="4" maxlength="1000" placeholder="Descreva sua dúvida ou solicitação"></textarea>
    <p class="small muted">As informações digitadas apenas compõem a mensagem nesta página; o envio pelo WhatsApp depende de sua confirmação e segue as regras desse serviço. Não inclua senhas, códigos de recuperação ou outros dados sensíveis.</p>
    <button type="submit" class="btn">Abrir WhatsApp</button>
    <p id="contact-status" class="small" role="status" aria-live="polite"></p>
   </form>
  </section>
 </div>
 <script>
  const form=document.querySelector<HTMLFormElement>('#contact-form')!;
  const subject=document.querySelector<HTMLSelectElement>('#contact-subject')!;
  const email=document.querySelector<HTMLInputElement>('#contact-email')!;
  const hint=document.querySelector<HTMLElement>('#email-description')!;
  const info=document.querySelector<HTMLElement>('#recovery-info')!;
  const status=document.querySelector<HTMLElement>('#contact-status')!;
  // Sugestões de correção vindas dos arquivos históricos: apenas pré-preenche.
  // O visitante revisa e confirma o envio manualmente pelo WhatsApp.
  const query=new URLSearchParams(location.search);
  if(query.get('tema')==='filmes-historia'){
   const target=query.get('jogo')||'jogo não identificado';
   const option=Array.from(subject.options).find(item=>item.value==='sugestao');
   if(option){subject.value=option.value;subject.dispatchEvent(new Event('change'))}
   const messageField=document.querySelector<HTMLTextAreaElement>('#contact-message')!;
   messageField.value=('Correção do artigo histórico — '+target+'\n'+'Filme/documentário ou plataforma a corrigir: ').slice(0,1000);
  }

  subject.addEventListener('change',()=>{
   const recovery=subject.value==='recuperacao';
   info.hidden=!recovery;
   email.required=false;
   hint.textContent='(opcional)';
  });
  form.addEventListener('submit',event=>{
   event.preventDefault();
   if(!form.reportValidity())return;
   const reason=subject.selectedOptions[0]?.textContent?.trim()||'Contato';
   const nickname=document.querySelector<HTMLInputElement>('#contact-nickname')!.value.trim();
   const message=document.querySelector<HTMLTextAreaElement>('#contact-message')!.value.trim();
   const lines=['OldArcade — solicitação de suporte','Assunto: '+reason];
   if(nickname)lines.push('Nickname: '+nickname);
   if(email.value.trim())lines.push('E-mail informado: '+email.value.trim());
   if(message)lines.push('Mensagem: '+message);
   if(subject.value==='recuperacao')lines.push('Solicito orientação sobre o acesso à minha conta. Não informarei senhas nem códigos.');
   const whatsapp=form.dataset.whatsapp;
   if(!whatsapp)return;
   const url='https://wa.me/'+whatsapp+'?text='+encodeURIComponent(lines.join('\n'));
   status.textContent='Abrindo WhatsApp para você revisar e enviar a mensagem.';
   window.open(url,'_blank','noopener,noreferrer');
  });
 </script>
</Base>
