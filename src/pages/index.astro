---
import Base from '../layouts/Base.astro';
import {gameRegistry} from '../data/gameRegistry';
import {gameModes} from '../data/gameModes.js';
const orderedGames=Object.entries(gameRegistry).sort((a,b)=>b[1].number-a[1].number);
const newestGame=orderedGames[0];
const featuredModes=Object.entries(gameModes).filter(([,mode])=>Object.hasOwn(gameRegistry,mode.title));
const modesByTitle=Object.fromEntries(orderedGames.map(([id])=>[id,featuredModes.filter(([,mode])=>mode.title===id)]));
const newestMode=featuredModes.find(([,mode])=>mode.title===newestGame[0]);
const title='OldArcade — Jogos clássicos grátis para jogar online';
const availableGames=Object.keys(gameRegistry).length;
const description='Jogue Snake e Tetris gratuitamente, acompanhe rankings por modalidade e descubra jogos clássicos no navegador.';
---
<Base title={title} description={description} path="/">
  <div class="shell arcade-home">
    <div class="arcade-dashboard">
      <aside class="arcade-sidebar" aria-label="Atalhos do jogador">
        <div class="arcade-sidebar-heading"><span class="eyebrow">Seu espaço</span><strong>Pronto para jogar?</strong><p>Seu próximo desafio está a um clique.</p></div>
        <nav class="arcade-side-nav" aria-label="Navegação da página inicial">
          <a class="active" href="#destaques" aria-current="location"><span aria-hidden="true">🎮</span> Jogos</a>
          <a href="/rankings/"><span aria-hidden="true">🏆</span> Rankings</a>
          <a href="/conta/" data-player-account-link><span aria-hidden="true">👤</span> <span data-player-name>Minha conta</span></a>
        </nav>
        <div class="arcade-side-foot">
          <span class="eyebrow">Desafie os líderes</span>
          <p>Conheça os líderes e desafie jogadores em cada modalidade.</p>
          <a href="/rankings/">Ver rankings <span aria-hidden="true">→</span></a>
        </div>
      </aside>
      <div class="arcade-dashboard-main">
        <section class="arcade-welcome" aria-labelledby="home-heading">
          <div class="arcade-welcome-copy">
            <span class="eyebrow">🎮 Novidade · Jogo #{String(newestGame[1].number).padStart(3,'0')}</span>
            <h1 id="home-heading">Chegou <span class="accent">{newestGame[1].name}!</span></h1>
            <p>{newestMode?.[1].description??'O mais novo desafio do OldArcade já está no catálogo.'} Grátis e direto no navegador.</p>
            <a class="btn" id="featured-game-link" data-featured-game={newestGame[0]} href={newestMode?.[1].url??'#destaques'}>▶ Jogar {newestGame[1].name} agora</a>
          </div>
          <div class="arcade-welcome-art" aria-hidden="true">
            <div class="arcade-screen"><div class="arcade-screen-label">OLD ARCADE · #{String(newestGame[1].number).padStart(3,'0')}</div><div class="arcade-featured-symbol">{newestMode?.[1].symbol??'🎮'}</div><strong class="arcade-featured-name">{newestGame[1].name}</strong><div class="arcade-screen-bottom">● NOVO JOGO ●</div></div>
          </div>
        </section>
        <div class="arcade-activity" aria-label="Estatísticas reais do OldArcade">
          <div class="arcade-activity-item"><span aria-hidden="true">🎮</span><strong id="hero-published-games">{availableGames}</strong><span>Jogos disponíveis</span></div>
          <div class="arcade-activity-item"><span aria-hidden="true">👥</span><strong id="hero-site-visits">—</strong><span>Visitas ao site</span></div>
          <div class="arcade-activity-item"><span aria-hidden="true">🏁</span><strong id="hero-total-plays">—</strong><span>Total de partidas</span></div>
        </div>
        <section id="home-daily" class="home-daily-spotlight" data-home-daily hidden aria-labelledby="home-daily-title">
          <div class="home-daily-copy">
            <span class="eyebrow">📅 Uma chance por dia · Benefício gratuito</span>
            <h2 id="home-daily-title">Desafio Diário: <span data-home-daily-name></span></h2>
            <p data-home-daily-copy>Uma tentativa por dia, uma surpresa diferente no OldArcade.</p>
          </div>
          <a class="btn" data-home-daily-link href="/conta/">Conhecer desafio</a>
        </section>
        <section class="arcade-games" id="destaques" aria-labelledby="games-heading">
          <div class="arcade-games-heading"><div><span class="eyebrow">Biblioteca de jogos</span><h2 id="games-heading">Escolha seu desafio</h2></div><span class="pill">{availableGames} {availableGames===1?'jogo':'jogos'} · {featuredModes.length} modos</span></div>
          <div class="arcade-mode-grid home-game-grid">
            {orderedGames.map(([id,game])=><article class="home-game-card" data-home-game={id}>
              <div class="home-game-art"><img src={id==='snake'?'/images/snake-arcade.svg':'/images/tetris-arcade.svg'} alt={id==='snake'?'Cobrinha pixelada no tabuleiro neon':'Blocos de Tetris coloridos em queda'} loading="lazy" width="680" height="300" /></div>
              <div class="home-game-body">
                <div class="home-game-heading"><span class="eyebrow">Jogo #{String(game.number).padStart(3,'0')}</span><h3>{game.name}</h3></div>
                <p>{id==='snake'?'A cobrinha clássica ganha aventuras, poderes e novas maneiras de desafiar seus reflexos.':'Encaixe as peças, limpe linhas e escolha entre pontuação, velocidade e resistência.'}</p>
                <nav class="home-game-modes" aria-label={'Modos do '+game.name}>
                  {modesByTitle[id].map(([modeId,mode])=><a href={mode.url} aria-label={'Jogar '+mode.name}>{mode.symbol} {mode.name.slice(game.name.length).trim()||'Clássico'}</a>)}
                </nav>
              </div>
            </article>)}
          </div>
        </section>
        <section class="arcade-footer-links" aria-label="Descubra mais">
          <a href="/rankings/"><strong>🏆 Rankings</strong><span>Confira os líderes e escolha um desafio <span aria-hidden="true">→</span></span></a>
          <a href="/conta/" data-player-account-link><strong>👤 Minha conta</strong><span><span data-player-name>Minha conta</span> <span aria-hidden="true">→</span></span></a>
          <a href="/sobre/"><strong>📚 História do arcade</strong><span>Conheça nosso projeto <span aria-hidden="true">→</span></span></a>
        </section>
      </div>
    </div>
  </div>
  <script>import '../scripts/homeDaily.ts';</script>
  <style>
   .arcade-featured-symbol{font-size:clamp(2.5rem,5vw,4.5rem);line-height:1.1;filter:drop-shadow(0 5px 11px #0008)}
   .arcade-featured-name{display:block;color:#fff0a6;font-size:clamp(.9rem,2vw,1.35rem);letter-spacing:.13em;text-transform:uppercase}
  </style>
</Base>
