---
import Base from '../layouts/Base.astro';
import {gameRegistry} from '../data/gameRegistry';
import {gameModes} from '../data/gameModes.js';
const gameNames=Object.fromEntries(Object.entries(gameRegistry).map(([id,entry])=>[id,entry.name]));
const featuredModes=Object.entries(gameModes).filter(([,mode])=>Object.hasOwn(gameRegistry,mode.title));
const title='OldArcade — Jogos clássicos grátis para jogar online';
const availableGames=Object.keys(gameRegistry).length;
const description='Jogue Snake clássico e Aventura gratuitamente, acompanhe os rankings de cada modo e conheça a história dos videogames clássicos.';
---
<Base title={title} description={description} path="/">
  <div class="shell arcade-home">
    <div class="arcade-dashboard">
      <aside class="arcade-sidebar" aria-label="Atalhos do jogador">
        <div class="arcade-sidebar-heading"><span class="eyebrow">Seu espaço</span><strong>Pronto para jogar?</strong><p>Seu próximo desafio está a um clique.</p></div>
        <nav class="arcade-side-nav" aria-label="Navegação da página inicial">
          <a class="active" href="#destaques" aria-current="location"><span aria-hidden="true">🎮</span> Jogos</a>
          <a href="/rankings/"><span aria-hidden="true">🏆</span> Rankings</a>
          <a href="/conta/" data-player-account-link><span aria-hidden="true">👤</span> <span data-player-name>Minha conta</span></a>
        </nav>
        <div class="arcade-side-foot">
          <span class="eyebrow">Sua jornada</span>
          <p>Guarde seus melhores resultados na conta e desafie amigos nos dois modos do Snake.</p>
          <a href="/conta/" data-player-account-link>Ver <span data-player-name>Minha conta</span> <span aria-hidden="true">→</span></a>
        </div>
      </aside>
      <div class="arcade-dashboard-main">
        <section class="arcade-welcome" aria-labelledby="home-heading">
          <div class="arcade-welcome-copy">
            <span class="eyebrow">Seu fliperama online</span>
            <h1 id="home-heading">Os clássicos nunca dão <span class="accent">game over.</span></h1>
            <p>Jogue, supere recordes e descubra novos desafios. Grátis e direto no navegador.</p>
            <a class="btn" href="/jogos/snake/">▶ Jogar Snake agora</a>
          </div>
          <div class="arcade-welcome-art" aria-hidden="true">
            <div class="arcade-screen"><div class="arcade-screen-label">OLD ARCADE</div><div class="pixel-snake"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><div class="arcade-screen-bottom">● PLAY ●</div></div>
          </div>
        </section>
        <div class="arcade-activity" aria-label="Estatísticas reais do OldArcade">
          <div class="arcade-activity-item"><span aria-hidden="true">🎮</span><strong id="hero-published-games">{availableGames}</strong><span>Jogos disponíveis</span></div>
          <div class="arcade-activity-item"><span aria-hidden="true">👥</span><strong id="hero-site-visits">—</strong><span>Visitas ao site</span></div>
          <div class="arcade-activity-item"><span aria-hidden="true">🏁</span><strong id="hero-total-plays">—</strong><span>Total de partidas</span></div>
        </div>
        <section class="arcade-games" id="destaques" aria-labelledby="games-heading">
          <div class="arcade-games-heading"><div><span class="eyebrow">Biblioteca de jogos</span><h2 id="games-heading">Escolha seu desafio</h2></div><span class="pill">{availableGames} jogo · {featuredModes.length} modos</span></div>
          <div class="arcade-mode-grid">
            {featuredModes.map(([id,mode],index)=><article class="arcade-mode-card">
              <div class={'arcade-mode-image '+(index===0?'arcade-mode-classic':'arcade-mode-adventure')} aria-hidden="true">
                {index===0?<div class="pixel-snake"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>:<span class="arcade-mode-fruits">🍎 <span>✦</span> ❄</span>}
                <span>{String(index+1).padStart(2,'0')} / {index===0?'CLÁSSICO':'AVENTURA'}</span>
              </div>
              <div class="arcade-mode-detail"><span class="eyebrow">{gameNames[mode.title]} · {mode.name}</span><h3>{mode.tagline}</h3><p>{mode.description}</p><a class={index===0?'btn':'btn secondary'} href={mode.url}>▶ Jogar {mode.name.startsWith(gameNames[mode.title]+' ')?mode.name.slice(gameNames[mode.title].length+1):mode.name}</a></div>
            </article>)}
          </div>
        </section>
        <section class="arcade-footer-links" aria-label="Descubra mais">
          <a href="/rankings/"><strong>🏆 Rankings</strong><span>Confira os líderes e escolha um desafio <span aria-hidden="true">→</span></span></a>
          <a href="/conta/" data-player-account-link><strong>👤 Meus recordes</strong><span><span data-player-name>Minha conta</span> <span aria-hidden="true">→</span></span></a>
          <a href="/sobre/"><strong>📚 História do arcade</strong><span>Conheça nosso projeto <span aria-hidden="true">→</span></span></a>
        </section>
      </div>
    </div>
  </div>
</Base>
