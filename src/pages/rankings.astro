---
import Base from '../layouts/Base.astro';
import RankingsMode from '../components/RankingsMode.astro';
import TetrisRankBrowser from '../components/TetrisRankBrowser.astro';
import {gameModes} from '../data/gameModes.js';
import {gameRegistry} from '../data/gameRegistry';
const groups=Object.entries(gameRegistry)
 .map(([gameId,game])=>({gameId,game,modes:Object.entries(gameModes).filter(([,mode])=>mode.title===gameId&&mode.competitive).map(([key])=>key)}))
 .filter(group=>group.modes.length>0);
---
<Base title="Rankings Old Arcade — Líderes, recordes e desafios" description="Confira o Top 3 e o Top 10 de cada modalidade do Snake, Tetris e Pixel Quest. Compare recordes de contas cadastradas e desafie seus líderes." path="/rankings/">
 <div class="shell rankings-page">
  <header class="rankings-hero">
   <div><span class="eyebrow">Competição Old Arcade</span><h1>Rankings e <span class="accent">desafios</span></h1><p>Escolha um jogo e explore suas modalidades. Os recordes de cada modo são independentes e pertencem a contas cadastradas.</p></div>
   <a class="btn secondary" href="/#destaques">Escolher jogo</a>
  </header>
  <nav class="rankings-jump" aria-label="Navegação entre jogos do ranking">
   {groups.map(group=><a href={'#rankings-'+group.gameId}>{group.game.name} · {group.modes.length} modos</a>)}
  </nav>
  <div class="rankings-list">
   {groups.map(group=><section class="rankings-game-card" data-rank-page-game={group.gameId} id={'rankings-'+group.gameId} aria-label={'Rankings de '+group.game.name}>
    <header class="rankings-game-heading">
     <div><span class="eyebrow">Jogo #{String(group.game.number).padStart(3,'0')}</span><h2>{group.game.name}</h2></div>
     <span class="pill">{group.modes.length} modalidades</span>
    </header>
    <div class="rankings-modes">
     {group.modes.map((modeId,i)=><RankingsMode modeId={modeId} initiallyOpen={i===0} />)}
     {group.gameId==='tetris'&&<TetrisRankBrowser />}
    </div>
   </section>)}
  </div>
  <p class="rankings-disclaimer small muted">Somente resultados vinculados a contas entram no ranking. No Sprint vence o menor tempo; na Sobrevivência vence o maior tempo; nos demais modos vence a maior pontuação. Desempates seguem os critérios registrados para cada modo. As pontuações ainda não são verificadas pelo servidor contra a execução da partida. Não exibimos valores fictícios quando a consulta falha.</p>
 </div>
 <script>import '../scripts/rankingsPage.ts';</script>
</Base>
